# Copy to `.env` (gitignored) and run IntelliJ / `gradlew bootRun`.
# OS or IntelliJ에 이미 있는 환경변수가 있으면 .env보다 우선한다.
# Docker 서버는 이 파일이 아니라 planwith-infra/env/member.env 를 쓴다.

DB_URL=jdbc:mysql://127.0.0.1:3307/member_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=member_user
DB_PASSWORD=member_pass
JPA_DDL_AUTO=update

SERVER_PORT=8082
# 로컬 Gateway(:8000) + 이 PC member: false
# 서버 Gateway/Eureka를 쓸 때만 true + 서버 Eureka 주소
EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true
MEMBER_KAFKA_ENABLED=false
MANAGEMENT_HEALTH_KAFKA_ENABLED=false
GATEWAY_TRUST_CHECK_ENABLED=false
GATEWAY_INTERNAL_TOKEN=

PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_STUB_ENABLED=true

EMAIL_STUB_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

SOCIAL_STUB_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

JWT_ISSUER=http://localhost:8082
JWT_AUDIENCE=planwith-api
# Gateway와 동일한 32바이트 이상의 랜덤 시크릿을 사용한다.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth
